# Server-side only. Never expose these values to the browser.
PERFECT_API_KEY=
PERFECT_API_BASE=https://yce-api-01.makeupar.com
SERPAPI_KEY=
SESSION_TTL_SECONDS=3600

# Edge-to-Rig endpoint. Use HTTPS outside local development.
RELAY_RIG_URL=

# Rig relay runtime. Provider selection is explicit and fail-closed.
# Supported: ollama | openai
RIG_PROVIDER=
RIG_MODEL=
RELAY_RIG_BIND=127.0.0.1:8788

# Required only when RIG_PROVIDER=openai.
OPENAI_API_KEY=
